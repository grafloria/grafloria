{
  // The ESM build the `module` field promises. Emits esm/src/**/*.js beside
  // the in-place CJS build; consumed by bundlers (tree-shaking), never by the
  // `main` path. Types stay with the CJS build (src/**/*.d.ts).
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "module": "es2020",
    "outDir": "esm",
    "rootDir": ".",
    "declaration": false,
    "noEmitOnError": false
  }
}
