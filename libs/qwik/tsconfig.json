{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    // Qwik ships its own JSX runtime. `react-jsx` is the transform MODE (the
    // automatic runtime), not React: `jsxImportSource` is what points it at
    // Qwik, so `<div/>` compiles to `@builder.io/qwik/jsx-runtime`'s `jsx()`.
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik"
  },
  "files": [],
  "include": [],
  "references": [{ "path": "./tsconfig.lib.json" }, { "path": "./tsconfig.spec.json" }]
}
