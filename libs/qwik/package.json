{
  "name": "@grafloria/qwik",
  "version": "0.12.0",
  "description": "Qwik bindings for Grafloria Diagrams and Grafloria Dashboards — an MIT diagram and dashboard engine: routing, auto-layout, undo, collaboration and dashboard layouts, server-rendered and resumable in Qwik.",
  "license": "MIT",
  "author": "Ramy Othman",
  "homepage": "https://grafloria.com/qwik/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafloria/grafloria.git",
    "directory": "libs/qwik"
  },
  "bugs": {
    "url": "https://github.com/grafloria/grafloria/issues"
  },
  "keywords": [
    "diagram",
    "flowchart",
    "graph",
    "node-editor",
    "qwik",
    "resumable",
    "ssr",
    "svg",
    "layout",
    "dashboard",
    "dashboard-layout",
    "workflow-editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.qwik.mjs",
  "module": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./lib/index.qwik.mjs",
      "default": "./lib/index.qwik.mjs"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs",
      "default": "./vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@grafloria/engine": "^0.5.0",
    "@grafloria/renderer": "^0.6.0",
    "@builder.io/qwik": "^1.5.0",
    "@grafloria/element": "^0.6.0"
  },
  "files": [
    "lib/index.qwik.mjs",
    "lib/index.qwik.mjs.map",
    "src/**/*.d.ts",
    "vite.mjs",
    "vite.d.ts"
  ],
  "type": "module"
}
